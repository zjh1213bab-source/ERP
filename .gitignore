# 依赖
node_modules/

# 环境变量（含密码，不入库）
.env
.env.local

# 构建产物
dist/

# 数据库文件
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
# 上线清单的目录可写探测残留（2 字节探针文件，正常会被删掉，异常时别进版本库）
backend/data/.golive-probe-*
# 迁移前手工备份的库快照（一份 70MB+，绝不能进版本库）
backend/data/*.db.bak-*
# 上传文件与现场照片（运行时数据，体积大，不入库）
backend/data/uploads/

# 备份与恢复留档（体积大、属于运行时数据，不入库）
backend/data/backups/
backend/data/replaced/
backend/data/_drill-state.json
backend/data/restore-pending.db
backend/data/restore-plan.json

# 本地 npm 缓存（装依赖时用工作区缓存避免 EPERM）
.npmcache/

# 发布打包产物（由 backend/scripts/pack-release.js 生成，体积大，不入库）
packages/

# 日志
logs/
*.log

# 系统
.DS_Store
Thumbs.db

# 交接包（由 backend/scripts/make-handoff-pack.js 生成，不入库）
handoff/
handoff-*.zip
