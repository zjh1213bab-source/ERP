{
  "name": "erp-mindmap-backend",
  "version": "1.0.0",
  "private": true,
  "description": "跳色科技公司 ERP 完整版思维导图系统 - 后端服务（Express + SQLite）",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "smoke": "node scripts/run-smoke-isolated.js",
    "smoke:multi": "node scripts/run-smoke-isolated.js --multi",
    "rbac": "node scripts/rbac-audit.js --md ../docs/RBAC.md",
    "shot": "node scripts/ui-shot.js",
    "pack": "node scripts/pack-release.js",
    "audit:data": "node scripts/audit-demo-data.js",
    "clean:data": "node scripts/audit-demo-data.js --clean",
    "reset:data": "node scripts/reset-business-data.js",
    "reset:data:apply": "node scripts/reset-business-data.js --apply",
    "verify:data": "node scripts/audit-demo-data.js --verify",
    "test:race": "node scripts/test-report-race.js",
    "prune:data": "node scripts/prune-data.js",
    "check:schema": "node scripts/check-schema-complete.js",
    "handoff": "node scripts/make-handoff-pack.js",
    "ai:image:install": "node scripts/install-image-search.js",
    "test:image-search": "node scripts/test-sample-image-search.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  }
}
