# ===== 服务配置 =====
# 后端监听端口
PORT=3000

# JWT 签名密钥 —— 上线务必改成随机长字符串（例如 openssl rand -hex 32）
JWT_SECRET=please_change_me_to_a_long_random_secret_string
# 登录令牌有效期
TOKEN_EXPIRES_IN=12h

# ===== 管理员账号（登录后台用）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== 跨域 =====
# 允许的前端来源，多个用英文逗号分隔；* 表示允许全部（前后端同域时可不依赖）
CORS_ORIGIN=*

# ===== 反向代理 / 客户端 IP =====
# 决定 req.ip 到底取谁 —— 登录限流是按 IP 分桶的，配错会锁错人：
#   loopback（默认）  只信任本机 Nginx 反代，取其追加的真实客户端 IP —— 推荐
#   1 / true          信任最近一层代理（云负载均衡）
#   10.0.0.0/8        信任指定网段（前后端不同机）
#   0                 完全直连、不反代时关掉
# 不配这个，反代后所有请求的 req.ip 都是 127.0.0.1，全公司共用一个限流桶。
TRUST_PROXY=loopback

# ===== 登录限流（按 IP + 按账号三道闸）=====
# 每 IP 每窗口总尝试上限（防 CPU 洪水：登录要跑 scrypt，几十并发就能拖垮单进程）
# 给 240 是因为一次完整冒烟要登录上百次；60 秒内连跑两趟会撞上限
LOGIN_ATTEMPT_MAX=240
# 每 IP 每窗口「失败」上限（防单机撞库；成功登录不占这个额度，否则早高峰会连坐同事）
LOGIN_FAIL_IP_MAX=20
# 窗口长度（秒）
LOGIN_WINDOW_SEC=60
# 同一账号连续失败几次开始锁（之后逐次翻倍）
LOGIN_FAIL_MAX=5
# 首次锁定时长（秒）与封顶（秒）
LOGIN_LOCK_SEC=300
LOGIN_LOCK_MAX_SEC=1800

# ===== 公司口径（单公司 / 多主体）=====
# 默认单公司：一个公司抬头（companies 里总部那条），所有人看同一套数据，
#              集团管理入口隐藏（接口保留），写入恒落这一个抬头。
# 写 0 切回多主体：按 users.company_id 过滤、跨主体读单据 404、公司下拉列全部启用主体。
# 切换不用迁数据 —— company_id 一直在写，只是不再拿来过滤。
# 详见 deploy/DEPLOY.md §9.4。
SINGLE_COMPANY=1

# ===== 数据库 =====
# SQLite 文件路径（相对 backend 根目录）；目录不存在会自动创建
DB_PATH=./data/erp-mindmap.db

# ===== AI 问答（可选）=====
# 留空则智能助手的「AI 问答」使用规则式回答；配置后自动走大模型（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== 钉钉考勤同步（可选）=====
# 不填不影响启动：同步接口会明确回「未配置」，不会假装成功。
# 获取方式：钉钉开放平台 → 应用开发 → 企业内部应用 → 创建应用，
#   拿到 AppKey / AppSecret，并给应用加「查询企业考勤数据权限」后发布。
# 注意：标准版 Open API 额度 1 万次/月，按天同步 30 人约 30~60 次/月，够用。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 每次回补几天（钉钉考勤同步有延迟，只拉当天会漏）
DINGTALK_SYNC_DAYS=3
# 自动同步时段（业务本地时间，逗号分隔）：默认中午 12:00 一次、跨日 00:00 一次
DINGTALK_SYNC_SCHEDULE=12:00,00:00
# 错过时段后多久内还会补跑一次（小时）。太大＝半夜把中午的账补到晚上，时间看着不对
DINGTALK_SYNC_CATCHUP_HOURS=6
# 调试用：指向本地 mock；正式环境留空即用官方地址
DINGTALK_BASE_URL=
# 进程内定时器总开关：临时实例 / 冒烟务必设 0，否则会把真实考勤写进临时库
# （正常部署不用设，默认就是开）
ERP_SCHEDULER=
