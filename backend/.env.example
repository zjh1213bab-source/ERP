# ===== 服务配置 =====
# 后端监听端口
PORT=3000

# JWT 签名密钥 —— 上线务必改成随机长字符串（例如 openssl rand -hex 32）
JWT_SECRET=please_change_me_to_a_long_random_secret_string
# 登录令牌有效期
TOKEN_EXPIRES_IN=12h

# ===== 管理员账号（登录后台用）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== 跨域 =====
# 允许的前端来源，多个用英文逗号分隔；* 表示允许全部（前后端同域时可不依赖）
CORS_ORIGIN=*

# ===== 公司口径（单公司 / 多主体）=====
# 默认单公司：一个公司抬头（companies 里总部那条），所有人看同一套数据，
#              集团管理入口隐藏（接口保留），写入恒落这一个抬头。
# 写 0 切回多主体：按 users.company_id 过滤、跨主体读单据 404、公司下拉列全部启用主体。
# 切换不用迁数据 —— company_id 一直在写，只是不再拿来过滤。
# 详见 deploy/DEPLOY.md §9.4。
SINGLE_COMPANY=1

# ===== 数据库 =====
# SQLite 文件路径（相对 backend 根目录）；目录不存在会自动创建
DB_PATH=./data/erp-mindmap.db

# ===== AI 问答（可选）=====
# 留空则智能助手的「AI 问答」使用规则式回答；配置后自动走大模型（OpenAI 兼容接口）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
